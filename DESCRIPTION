Package: mvrem
Title: Multivariate Joint Models with INLA
Version: 0.1.0
Authors@R: c(
    person("Szymon M.", "Kiełbasa", role = c("aut", "cre"), email = "S.M.Kielbasa@lumc.nl"),
    person("Chiara", "Degan", role = c("aut"), email = "C.Degan@lumc.nl"),
    person("Bart", "Mertens", role = c("ctb"), email = "B.J.A.Mertens@lumc.nl"),
